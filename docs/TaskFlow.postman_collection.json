            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Nuovo task\",\n  \"description\": \"Cosa fare\",\n  \"assignee\": \"\",\n  \"dueDate\": \"2026-12-31\",\n  \"priority\": \"medium\",\n  \"status\": \"todo\"\n}",
              "options": {
